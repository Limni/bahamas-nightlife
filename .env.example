# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (they ship in the browser bundle); access is enforced
# by the RLS policies in supabase/schema.sql. Never put the service-role key here.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# Only for `npm run seed:google` (runs on your machine, never in the browser).
# These are SECRET: keep them out of git and never give them a VITE_ prefix.
#   GOOGLE_MAPS_API_KEY: Google Cloud key with "Places API (New)" enabled
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role
# GOOGLE_MAPS_API_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: map tiles. Defaults to Stadia Maps "Alidade Smooth Dark", which works on
# localhost with no key. For your live domain, create a free account at
# stadiamaps.com and add the domain there (no code change), or append
# ?api_key=YOUR_KEY to the URL below.
# VITE_MAP_TILE_URL="https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png"
# VITE_MAP_ATTRIBUTION="&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap"
